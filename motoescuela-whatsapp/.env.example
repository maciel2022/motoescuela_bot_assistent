PORT=3000

# Meta / WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=inventa_una_cadena_larga_aqui
WHATSAPP_APP_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
GRAPH_API_VERSION=v21.0
# Solo mientras se use el numero de PRUEBA de Meta. Quita el 9 de los celulares
# argentinos al enviar, porque la lista de destinatarios autorizados los guarda
# sin el 9 pero los webhooks entrantes traen el wa_id con 9.
# En produccion no hace falta: dejar en false o quitar la linea.
WHATSAPP_NORMALIZAR_AR=false

# OpenAI
