# Valores ficticios para la suite de tests. NO son secretos: ningun test
# llama a las APIs reales de OpenAI ni de Meta, siempre usan dobles.
# Este archivo se versiona a proposito, para que la suite corra en un clon
# limpio o en CI sin depender de un .env con credenciales.
PORT=3000

WHATSAPP_VERIFY_TOKEN=token_de_verificacion_de_prueba
WHATSAPP_APP_SECRET=app_secret_de_prueba
WHATSAPP_TOKEN=token_de_prueba
WHATSAPP_PHONE_NUMBER_ID=000000000000000
GRAPH_API_VERSION=v21.0

OPENAI_API_KEY=sk-no-se-usa-en-tests
OPENAI_MODEL=gpt-4o-mini
OPENAI_VECTOR_STORE_ID=vs_no_se_usa_en_tests

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=motoescuela_test

HISTORY_LIMIT=10
LOG_LEVEL=error
